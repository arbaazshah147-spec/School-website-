<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Login | Shri Anand Construction</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background: #000; display: flex; align-items: center; justify-content: center; height: 100vh;">
    <div style="background: #111; padding: 3rem; border: 1px solid var(--primary); border-radius: 10px; width: 400px;">
        <h2 class="luxury-font" style="color: var(--primary); text-align: center; margin-bottom: 2rem;">Admin Login</h2>
        <form action="/admin/login" method="POST">
            <div style="margin-bottom: 1.5rem;">
                <label style="color: #fff;">Email</label>
                <input type="email" name="email" required style="width: 100%; padding: 0.8rem; background: #222; border: 1px solid #333; color: #fff; border-radius: 5px; margin-top: 0.5rem;">
            </div>
            <div style="margin-bottom: 1.5rem;">
                <label style="color: #fff;">Password</label>
                <input type="password" name="password" required style="width: 100%; padding: 0.8rem; background: #222; border: 1px solid #333; color: #fff; border-radius: 5px; margin-top: 0.5rem;">
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
        </form>
        <p style="text-align: center; margin-top: 1rem;"><a href="/" style="color: #666; font-size: 0.9rem;">Back to Home</a></p>
    </div>
</body>
</html>
