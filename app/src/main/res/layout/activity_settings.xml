<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General Settings"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_ai_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AI Name (e.g., Jarvis)"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your Name"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_wake_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wake Word (e.g., Hey Nova)"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_welcome_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom Welcome Response"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Keys"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_gemini_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini API Key"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_chatgpt_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ChatGPT API Key"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_grok_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grok API Key"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_personal_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your preferences, interests, etc."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Command Builder"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_command_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Command Name (e.g., 'Good Morning')"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_command_trigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trigger Phrase (e.g., 'morning routine')"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_command_action_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Action Type (e.g., 'OPEN_APP')"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edit_command_action_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Action Value (e.g., 'com.android.chrome')"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/primary_text"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/add_command_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Command"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/save_settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save All Settings" />

    </LinearLayout>
</ScrollView>
